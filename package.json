{
  "name": "rgb",
  "version": "2.0.2",
  "private": true,
  "description": "RGB-PC is a LED client for PC for Govee lights",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "electron:build": "electron-vite build && electron-builder",
    "publish": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "productName": "RGB-PC-evolution",
    "appId": "com.rgb.pcevolution",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      { "from": "rgb.ico", "to": "rgb.ico" }
    ],
    "win": {
      "icon": "./rgb.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "zip",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./rgb.ico"
    }
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "@simonwep/pickr": "^1.8.2",
    "bootstrap": "^5.2.0",
    "sharp": "^0.34.5",
    "vue": "^3.5.0",
    "vue-slider-component": "^4.1.0-beta.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "vite": "^6.4.2"
  }
}
